generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  us
  eu
}

enum UserRole {
  admin
  ap_manager
  ap_clerk
  approver
}

enum UserStatus {
  invited
  active
  locked
}

enum AuthProviderType {
  local
  oidc
  saml
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  region    Region   @default(us)
  planName  String   @default("starter")
  approvedSoftLimit Int? @default(100)
  approvedHardLimit Int?
  createdAt DateTime @default(now())

  entities       Entity[]
  users          User[]
  userEntityMemberships UserEntityMembership[]
  moduleLicenses ModuleLicense[]
  authProviders  AuthProviderConfig[]
  sessions       Session[]
  vendors        Vendor[]
  glAccounts     GlAccount[]
  costCenters    CostCenter[]
  taxCodes       TaxCode[]
  paymentTerms   PaymentTerm[]
  fileAssets     FileAsset[]
  invoices       Invoice[]
  expenseCategories ExpenseCategory[]
  invoiceAttachments InvoiceAttachment[]
  usageEvents    UsageEvent[]
  ocrPageMeters  OcrPageMeter[]
  approvalPolicies ApprovalPolicy[]
  approvalTasks  ApprovalTask[]
  approvalRules  ApprovalRule[]
  sodPolicies    SodPolicy[]
  integrationJobs IntegrationJob[]
  captureMailbox CaptureMailbox?
  emailIngests   EmailIngest[]
  notifications  Notification[]
  auditEvents    AuditEvent[]
  apiKeys        ApiKey[]
  oauthClients   OAuthClient[]
  oauthAccessTokens OAuthAccessToken[]
  invoiceComments InvoiceComment[]
  contractComments ContractComment[]
  userInvites    UserInvite[]
  passwordResets PasswordResetToken[]
  contracts      Contract[]
  contractDocuments ContractDocument[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
  apAccruals     ApAccrual[]
  webhookEndpoints WebhookEndpoint[]
  connectorConnections ConnectorConnection[]
}

model ModuleLicense {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  moduleKey String
  enabled   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

model Entity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name     String
  code     String

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts         Contract[]
  expenseCategories ExpenseCategory[]
  userMemberships   UserEntityMembership[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  email            String
  displayName      String
  passwordHash     String?
  role             UserRole   @default(admin)
  status           UserStatus @default(active)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions       Session[]
  invites        UserInvite[]
  passwordResets PasswordResetToken[]
  entityMemberships UserEntityMembership[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserEntityMembership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  entityId  String   @db.Uuid
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, entityId])
}

model UserInvite {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model AuthProviderConfig {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  type     AuthProviderType
  enabled  Boolean          @default(false)
  order    Int              @default(0)
  settings Json             @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  code         String
  name         String
  email        String?
  taxId        String?
  paymentTermId String? @db.Uuid
  externalId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  contracts   Contract[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
}

model GlAccount {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseCategories ExpenseCategory[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TaxCode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  rateBps   Int      @default(0) // basis points, e.g. 2300 = 23.00%
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Per-entity spend category → default GL account (OCR keyword hints optional).
model ExpenseCategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  entityId    String   @db.Uuid
  code        String
  name        String
  /// Comma-separated tokens matched against invoice line descriptions
  keywords    String   @default("")
  glAccountId String   @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entity    Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  glAccount GlAccount @relation(fields: [glAccountId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entityId, code])
  @@index([tenantId, entityId])
}

model PaymentTerm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  netDays     Int      @default(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendors Vendor[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum InvoiceStatus {
  captured
  extracting
  needs_review
  exception
  in_approval
  approved
  exported
  void
  paid
}

model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  pageCount    Int      @default(1)
  createdAt    DateTime @default(now())

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  attachments  InvoiceAttachment[]

  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  entityId       String?       @db.Uuid
  vendorId       String?       @db.Uuid
  purchaseOrderId String?      @db.Uuid
  fileAssetId    String?       @db.Uuid
  status         InvoiceStatus @default(captured)
  invoiceNumber  String?
  invoiceDate    DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  currency       String        @default("EUR")
  subtotalMinor  Int?
  taxMinor       Int?
  totalMinor     Int?
  vendorNameRaw  String?
  notes          String?
  ocrConfidence  Float?
  /// Structured OCR hits + normalized geometry for HITL overlays (versioned JSON)
  ocrPayload     Json?
  submittedById  String?       @db.Uuid
  approvedAt     DateTime?
  exportedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  exceptions    InvoiceException[]
  comments      InvoiceComment[]
  attachments   InvoiceAttachment[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, submittedById])
}

model InvoiceLine {
  id                 String  @id @default(uuid()) @db.Uuid
  invoiceId          String  @db.Uuid
  lineNo             Int
  description        String?
  quantity           Float?
  unitPriceMinor     Int?
  amountMinor        Int?
  taxMinor           Int?
  taxCodeId          String? @db.Uuid
  glAccountId        String? @db.Uuid
  costCenterId       String? @db.Uuid
  categoryId         String? @db.Uuid
  purchaseOrderLineId String? @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([invoiceId])
}

model InvoiceAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  invoiceId   String   @db.Uuid
  fileAssetId String   @db.Uuid
  label       String?
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
}

model InvoiceException {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  code      String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceComment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  invoiceId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId, createdAt])
}

model UsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  type      String
  refId     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, refId])
  @@index([tenantId, type])
}

model OcrPageMeter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  yearMonth String
  pages     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yearMonth])
}

enum ApprovalTaskStatus {
  pending
  approved
  rejected
}

model ApprovalPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  /** invoices | contracts | purchase_requests | purchase_orders | accruals */
  moduleKey            String   @default("invoices")
  name                 String   @default("Default policy")
  enabled              Boolean  @default(true)
  autoApproveUnderMinor Int?
  /** Ordered stage labels for staged modules (contracts/accruals). */
  chainJson            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
}

/// Amount/entity band rules evaluated before the default ApprovalPolicy threshold.
model ApprovalRule {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  moduleKey    String    @default("invoices")
  name         String
  entityId     String?   @db.Uuid
  minMinor     Int?
  maxMinor     Int?
  autoApprove  Boolean   @default(false)
  /// When not auto-approve: restrict assignees to this role (null = admin/approver/ap_manager)
  assigneeRole UserRole?
  priority     Int       @default(100)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, moduleKey, enabled, priority])
}

enum SodRuleKey {
  cannot_approve_own_invoice
  role_pair_conflict
}

/// Tenant segregation-of-duties policies for invoice approvals.
model SodPolicy {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @db.Uuid
  ruleKey        SodRuleKey
  enabled        Boolean    @default(true)
  /// For role_pair_conflict: submitter role that cannot be approved by approverRole
  submitterRole  UserRole?
  approverRole   UserRole?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
  @@index([tenantId, ruleKey])
}

model ApprovalTask {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  invoiceId    String             @db.Uuid
  assigneeId   String             @db.Uuid
  status       ApprovalTaskStatus @default(pending)
  comment      String?
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assigneeId, status])
  @@index([invoiceId])
}

enum IntegrationJobType {
  export_approved_invoices
  export_contracts
  export_purchase_requests
  export_purchase_orders
  import_vendors
  import_gl_accounts
  sync_demo_erp
  sync_netsuite
  sync_qbo
}

enum IntegrationJobStatus {
  pending
  succeeded
  failed
}

enum ConnectorConnectionStatus {
  connected
  disconnected
}

model IntegrationJob {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  type         IntegrationJobType
  status       IntegrationJobStatus @default(pending)
  fileName     String?
  storagePath  String?
  rowCount     Int                  @default(0)
  errorMessage String?
  createdById  String?              @db.Uuid
  createdAt    DateTime             @default(now())
  finishedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Tenant connection to a connector pack (mock or live OAuth later).
model ConnectorConnection {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @db.Uuid
  packKey         String
  status          ConnectorConnectionStatus  @default(disconnected)
  /// SHA-256 of mock/live access token — never return raw secret after connect
  credentialsHash String?
  settings        Json                       @default("{}")
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  createdById     String?                    @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, packKey])
  @@index([tenantId])
}

model CaptureMailbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  address   String    @unique
  token     String    @unique
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
}

model EmailIngest {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  messageId    String
  fromAddress  String?
  subject      String?
  status       String   @default("completed")
  errorMessage String?
  invoiceId    String?  @db.Uuid
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, messageId])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([prefix])
}

/// Partner / machine OAuth2 client (client_credentials).
model OAuthClient {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  name             String
  clientId         String    @unique
  clientSecretHash String
  scopes           String[]
  createdById      String?   @db.Uuid
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accessTokens OAuthAccessToken[]

  @@index([tenantId])
}

model OAuthAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  clientId  String   @db.Uuid
  tokenHash String   @unique
  scopes    String[]
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientId])
  @@index([expiresAt])
}

enum ContractStatus {
  draft
  in_approval
  pending_signature
  active
  expired
  cancelled
}

enum ApAccrualStatus {
  draft
  in_approval
  approved
  posted
  cancelled
}

enum PurchaseRequestStatus {
  draft
  in_approval
  approved
  converted
  cancelled
}

enum PurchaseOrderStatus {
  draft
  issued
  partially_received
  received
  closed
  cancelled
}

model Contract {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @db.Uuid
  entityId           String?        @db.Uuid
  vendorId           String?        @db.Uuid
  number             String
  title              String
  status             ContractStatus @default(draft)
  startDate          DateTime?      @db.Date
  endDate            DateTime?      @db.Date
  currency           String         @default("EUR")
  valueMinor         Int?
  notes              String?
  agreementType      String?
  purpose            String?
  serviceDescription String?
  costCenter         String?
  termType           String?
  noticePeriod       String?
  clmTool            String?
  ownerName          String?
  approvalStage      Int            @default(0)
  contractDate       DateTime?      @db.Date
  aiExtracted        Boolean        @default(false)
  redFlagsJson       Json?
  signatureJson      Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  entity         Entity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  comments       ContractComment[]
  documents      ContractDocument[]
  purchaseRequests PurchaseRequest[]
  apAccruals     ApAccrual[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
}

model ContractDocument {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  contractId  String   @db.Uuid
  category    String
  fileName    String
  storagePath String?
  createdAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, contractId])
}

model ContractComment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  contractId String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, contractId, createdAt])
}

model PurchaseRequest {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  entityId         String?               @db.Uuid
  vendorId         String?               @db.Uuid
  sourceContractId String?               @db.Uuid
  number           String
  title            String
  status           PurchaseRequestStatus @default(draft)
  requesterId      String?               @db.Uuid
  currency         String                @default("EUR")
  totalMinor       Int?
  notes            String?
  department       String?
  category         String?
  approvalStage    Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceContract Contract?             @relation(fields: [sourceContractId], references: [id], onDelete: SetNull)
  lines          PurchaseRequestLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, sourceContractId])
}

model PurchaseRequestLine {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseRequestId String @db.Uuid
  lineNo         Int
  description    String?
  quantity       Float?
  unitPriceMinor Int?
  amountMinor    Int?
  glAccountId    String? @db.Uuid

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@unique([purchaseRequestId, lineNo])
  @@index([purchaseRequestId])
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  entityId    String?             @db.Uuid
  vendorId    String?             @db.Uuid
  contractId  String?             @db.Uuid
  purchaseRequestId String?       @db.Uuid
  number      String
  title       String
  status      PurchaseOrderStatus @default(draft)
  currency    String              @default("EUR")
  totalMinor  Int?
  notes       String?
  issuedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract        Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  lines           PurchaseOrderLine[]
  invoices        Invoice[]
  accruals        ApAccrual[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  lineNo         Int
  description    String?
  quantity       Float?
  receivedQty    Float?  @default(0)
  unitPriceMinor Int?
  amountMinor    Int?
  glAccountId    String? @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
}

model ApAccrual {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  purchaseOrderId String         @db.Uuid
  contractId      String?        @db.Uuid
  vendorName      String?
  entityId        String?        @db.Uuid
  department      String?
  category        String?
  amountMinor     Int
  currency        String         @default("EUR")
  status          ApAccrualStatus @default(draft)
  approvalStage   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  contract      Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, purchaseOrderId])
}

enum WebhookDeliveryStatus {
  pending
  succeeded
  failed
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  url       String
  secret    String
  events    String[]
  enabled   Boolean  @default(true)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, enabled])
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  endpointId     String                @db.Uuid
  event          String
  payloadJson    String
  status         WebhookDeliveryStatus @default(pending)
  httpStatus     Int?
  errorMessage   String?
  attemptCount   Int                   @default(0)
  createdAt      DateTime              @default(now())
  finishedAt     DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([endpointId, createdAt])
}

model OidcAuthState {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  state        String   @unique
  codeVerifier String
  nonce        String
  redirectTo   String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}
