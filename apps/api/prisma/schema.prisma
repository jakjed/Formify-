generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  us
  eu
}

enum UserRole {
  admin
  ap_manager
  ap_clerk
  approver
}

enum UserStatus {
  invited
  active
  locked
}

enum AuthProviderType {
  local
  oidc
  saml
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  region    Region   @default(us)
  planName  String   @default("starter")
  approvedSoftLimit Int? @default(100)
  approvedHardLimit Int?
  createdAt DateTime @default(now())

  entities       Entity[]
  users          User[]
  moduleLicenses ModuleLicense[]
  authProviders  AuthProviderConfig[]
  sessions       Session[]
  vendors        Vendor[]
  glAccounts     GlAccount[]
  costCenters    CostCenter[]
  taxCodes       TaxCode[]
  paymentTerms   PaymentTerm[]
  fileAssets     FileAsset[]
  invoices       Invoice[]
  usageEvents    UsageEvent[]
  ocrPageMeters  OcrPageMeter[]
  approvalPolicies ApprovalPolicy[]
  approvalTasks  ApprovalTask[]
  integrationJobs IntegrationJob[]
  captureMailbox CaptureMailbox?
  emailIngests   EmailIngest[]
  notifications  Notification[]
  auditEvents    AuditEvent[]
  apiKeys        ApiKey[]
  invoiceComments InvoiceComment[]
  contractComments ContractComment[]
  userInvites    UserInvite[]
  passwordResets PasswordResetToken[]
  contracts      Contract[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders PurchaseOrder[]
}

model ModuleLicense {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  moduleKey String
  enabled   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

model Entity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name     String
  code     String

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  email            String
  displayName      String
  passwordHash     String?
  role             UserRole   @default(admin)
  status           UserStatus @default(active)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions       Session[]
  invites        UserInvite[]
  passwordResets PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserInvite {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model AuthProviderConfig {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  type     AuthProviderType
  enabled  Boolean          @default(false)
  order    Int              @default(0)
  settings Json             @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  code         String
  name         String
  email        String?
  taxId        String?
  paymentTermId String? @db.Uuid
  externalId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  contracts   Contract[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
}

model GlAccount {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TaxCode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  rateBps   Int      @default(0) // basis points, e.g. 2300 = 23.00%
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PaymentTerm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  netDays     Int      @default(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendors Vendor[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum InvoiceStatus {
  captured
  extracting
  needs_review
  exception
  in_approval
  approved
  exported
  void
  paid
}

model FileAsset {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  pageCount    Int      @default(1)
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  entityId       String?       @db.Uuid
  vendorId       String?       @db.Uuid
  fileAssetId    String?       @db.Uuid
  status         InvoiceStatus @default(captured)
  invoiceNumber  String?
  invoiceDate    DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  currency       String        @default("EUR")
  subtotalMinor  Int?
  taxMinor       Int?
  totalMinor     Int?
  vendorNameRaw  String?
  notes          String?
  ocrConfidence  Float?
  approvedAt     DateTime?
  exportedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileAsset FileAsset?         @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  lines     InvoiceLine[]
  exceptions InvoiceException[]
  comments  InvoiceComment[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceNumber])
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  lineNo      Int
  description String?
  quantity    Float?
  unitPriceMinor Int?
  amountMinor Int?
  glAccountId String? @db.Uuid
  costCenterId String? @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@index([invoiceId])
}

model InvoiceException {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  code      String
  message   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceComment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  invoiceId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId, createdAt])
}

model UsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  type      String
  refId     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, refId])
  @@index([tenantId, type])
}

model OcrPageMeter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  yearMonth String
  pages     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, yearMonth])
}

enum ApprovalTaskStatus {
  pending
  approved
  rejected
}

model ApprovalPolicy {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  name                 String   @default("Default invoice policy")
  enabled              Boolean  @default(true)
  autoApproveUnderMinor Int?    // null = never auto-approve
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
}

model ApprovalTask {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  invoiceId    String             @db.Uuid
  assigneeId   String             @db.Uuid
  status       ApprovalTaskStatus @default(pending)
  comment      String?
  createdAt    DateTime           @default(now())
  decidedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, assigneeId, status])
  @@index([invoiceId])
}

enum IntegrationJobType {
  export_approved_invoices
  import_vendors
  import_gl_accounts
}

enum IntegrationJobStatus {
  pending
  succeeded
  failed
}

model IntegrationJob {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @db.Uuid
  type         IntegrationJobType
  status       IntegrationJobStatus @default(pending)
  fileName     String?
  storagePath  String?
  rowCount     Int                  @default(0)
  errorMessage String?
  createdById  String?              @db.Uuid
  createdAt    DateTime             @default(now())
  finishedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model CaptureMailbox {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  address   String    @unique
  token     String    @unique
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  rotatedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId])
  @@index([tenantId])
}

model EmailIngest {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  messageId    String
  fromAddress  String?
  subject      String?
  status       String   @default("completed")
  errorMessage String?
  invoiceId    String?  @db.Uuid
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, messageId])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([prefix])
}

enum ContractStatus {
  draft
  in_approval
  active
  expired
  cancelled
}

enum PurchaseRequestStatus {
  draft
  in_approval
  approved
  converted
  cancelled
}

enum PurchaseOrderStatus {
  draft
  issued
  partially_received
  received
  closed
  cancelled
}

model Contract {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  entityId    String?        @db.Uuid
  vendorId    String?        @db.Uuid
  number      String
  title       String
  status      ContractStatus @default(draft)
  startDate   DateTime?      @db.Date
  endDate     DateTime?      @db.Date
  currency    String         @default("EUR")
  valueMinor  Int?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  entity         Entity?           @relation(fields: [entityId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  comments       ContractComment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
}

model ContractComment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  contractId String   @db.Uuid
  authorId   String   @db.Uuid
  body       String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, contractId, createdAt])
}

model PurchaseRequest {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @db.Uuid
  entityId     String?               @db.Uuid
  number       String
  title        String
  status       PurchaseRequestStatus @default(draft)
  requesterId  String?               @db.Uuid
  currency     String                @default("EUR")
  totalMinor   Int?
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines   PurchaseRequestLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseRequestLine {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseRequestId String @db.Uuid
  lineNo         Int
  description    String?
  quantity       Float?
  unitPriceMinor Int?
  amountMinor    Int?
  glAccountId    String? @db.Uuid

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@unique([purchaseRequestId, lineNo])
  @@index([purchaseRequestId])
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  entityId    String?             @db.Uuid
  vendorId    String?             @db.Uuid
  contractId  String?             @db.Uuid
  purchaseRequestId String?       @db.Uuid
  number      String
  title       String
  status      PurchaseOrderStatus @default(draft)
  currency    String              @default("EUR")
  totalMinor  Int?
  notes       String?
  issuedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract        Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  lines           PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id             String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  lineNo         Int
  description    String?
  quantity       Float?
  receivedQty    Float?  @default(0)
  unitPriceMinor Int?
  amountMinor    Int?
  glAccountId    String? @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
}

