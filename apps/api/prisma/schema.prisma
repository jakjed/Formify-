generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  us
  eu
}

enum UserRole {
  admin
  ap_manager
  ap_clerk
  approver
}

enum AuthProviderType {
  local
  oidc
  saml
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  region    Region   @default(us)
  createdAt DateTime @default(now())

  entities       Entity[]
  users          User[]
  moduleLicenses ModuleLicense[]
  authProviders  AuthProviderConfig[]
  sessions       Session[]
  vendors        Vendor[]
  glAccounts     GlAccount[]
  costCenters    CostCenter[]
  taxCodes       TaxCode[]
  paymentTerms   PaymentTerm[]
}

model ModuleLicense {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  moduleKey String
  enabled   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

model Entity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name     String
  code     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  email        String
  displayName  String
  passwordHash String
  role         UserRole @default(admin)
  createdAt    DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())
  expiresAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

model AuthProviderConfig {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @db.Uuid
  type     AuthProviderType
  enabled  Boolean          @default(false)
  order    Int              @default(0)
  settings Json             @default("{}")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  code         String
  name         String
  email        String?
  taxId        String?
  paymentTermId String? @db.Uuid
  externalId   String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, name])
}

model GlAccount {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TaxCode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  name      String
  rateBps   Int      @default(0) // basis points, e.g. 2300 = 23.00%
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PaymentTerm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  code        String
  name        String
  netDays     Int      @default(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendors Vendor[]

  @@unique([tenantId, code])
  @@index([tenantId])
}
