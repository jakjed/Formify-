DATABASE_URL=postgresql://aptora:aptora@localhost:5432/aptora?schema=public
PORT=3001
NODE_ENV=development
APP_NAME=Procure Ledger
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
STORAGE_PATH=storage/uploads

# OCR: stub (default) | textract
OCR_PROVIDER=stub
AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

API_PUBLIC_URL=http://127.0.0.1:3001
# OIDC redirect_uri = {API_PUBLIC_URL}/api/auth/oidc/callback

# Session / MFA encryption. Change in production.
SESSION_SECRET=change-me-in-production

# Public tenant create: true | false. Default: open outside production.
# ALLOW_PUBLIC_BOOTSTRAP=true
# BOOTSTRAP_TOKEN=
