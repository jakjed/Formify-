{
  "name": "aptora",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@aptora/api --filter=@aptora/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter @aptora/api dev",
    "dev:web": "pnpm --filter @aptora/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aptora/api prisma:migrate",
    "db:deploy": "pnpm --filter @aptora/api prisma:deploy",
    "test:api": "pnpm --filter @aptora/api test",
    "test:e2e": "pnpm --filter @aptora/e2e test",
    "test:journey": "RUN_JOURNEY=1 pnpm --filter @aptora/api test -- phase1.journey",
    "seed:demo": "node --experimental-strip-types tooling/seed-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
